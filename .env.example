# SQLite in dev. For production (Postgres) use e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/moneymate"
DATABASE_URL="file:./dev.db"

# Server-side only. Never exposed to the client.
ANTHROPIC_API_KEY=""
# Optional — defaults to the latest Sonnet model.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Auth.js JWT secret. Generate with: openssl rand -base64 32
# Optional in local dev (a dev-only fallback is used); REQUIRED in production.
AUTH_SECRET=""

# Gates /admin and /api/admin/stats
ADMIN_KEY=""
